# Leave empty to use same-origin /api (Vite dev proxy locally, or the Vercel rewrite in vercel.json).
# Set to the backend origin only if you call the API cross-site (then set COOKIE_SAMESITE=none on the server).
VITE_API_URL=

# Public site URL used for canonical/Open Graph tags
VITE_SITE_URL=https://fujirestaurant.co.uk

# Dev only: where Vite proxies /api (default http://localhost:5000)
VITE_DEV_API_PROXY=http://localhost:5000
