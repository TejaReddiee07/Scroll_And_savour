# Copy to .env and fill in. Never commit .env.

# --- Server -------------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=5000

# --- Database -----------------------------------------------------------------
# The server boots without a database (only /api/health works, everything else
# returns 503 DB_UNAVAILABLE) and keeps retrying in the background.
# In development this defaults to mongodb://127.0.0.1:27017/fuji_restaurant.
MONGODB_URI=mongodb://127.0.0.1:27017/fuji_restaurant

# --- Admin auth ---------------------------------------------------------------
# REQUIRED in production (the server refuses to start without it). Use a long random
# value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random per-process secret is used if empty (sessions reset on restart).
JWT_SECRET=

# Comma-separated allowlist of browser origins allowed to call the API with cookies
# (no trailing slash). Defaults to http://localhost:5173 in development.
CLIENT_ORIGIN=http://localhost:5173

# Admin cookie (fuji_admin) settings.
# lax  = frontend and API on the same site (e.g. example.com + api.example.com, or a dev proxy)
# none = frontend and API on different sites (forces COOKIE_SECURE=true; requires HTTPS)
COOKIE_SAMESITE=lax
# true | false — defaults to true when NODE_ENV=production
COOKIE_SECURE=

# --- Seeded owner account (npm run seed) --------------------------------------
# Created or updated on every seed run. Password must be at least 10 characters.
# Leave empty to skip admin creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Dish photo uploads (Admin → Menu items) -----------------------------------
# Without Cloudinary, uploaded photos are stored on this server's disk (UPLOADS_DIR, default server/uploads)
# and served at /api/uploads/… — fine on your own PC or a VPS. On hosts with a temporary disk
# (Render free plan, Railway without a volume) set the Cloudinary variables below instead.
UPLOADS_DIR=
# Automatic background removal for uploaded photos (food on black, like the rest of the menu).
# Needs the model file once: `npm run cutout-model` (~170 MB, saved to server/models/).
# Uses ~1 GB of memory for a few seconds per upload; set to false on very small servers.
PHOTO_CUTOUTS=true
CUTOUT_MODEL=
# Optional: Cloudinary (photos hosted by Cloudinary instead of this server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fuji-restaurant

# --- Online payments (Stripe) -------------------------------------------------
# Get these from https://dashboard.stripe.com/test/apikeys (use TEST keys first: pk_test_ / sk_test_).
# Leave empty to switch online payments off (customers can still choose "pay on collection").
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Locally: `stripe listen --forward-to localhost:5000/api/payments/webhook`
# prints one. In production: Dashboard -> Developers -> Webhooks -> endpoint https://YOUR-API/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
# Payment methods advertised on the site. Each must also be switched on in
# Stripe Dashboard -> Settings -> Payment methods (Apple Pay also needs your domain registered there).
STRIPE_METHODS=card,apple_pay,google_pay,revolut_pay,klarna
# Allow "pay on collection / delivery" as well as paying online (true/false)
PAYMENTS_IN_PERSON=true
